    "model": "deepseek-flash",
    "reasoningEffort": "low",
    "authToken": "",
    "authHeader": "authorization",
    "authPrefix": "Bearer",
    "allowRemote": false
  },
  "role": {
    "maxInjectChars": 6000
  },
